---
layout: null
permalink: /site.webmanifest
---
{
  "name": "{{ site.title }}",
  "short_name": "Spec HTML",
  "description": "{{ site.description }}",
  "lang": "{{ site.lang | default: 'ja' }}",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#f5f4ef",
  "theme_color": "#161922",
  "icons": [
    {
      "src": "{{ '/assets/img/favicon.svg' | relative_url }}",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
