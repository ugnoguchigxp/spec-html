{
  "name": "spec-html",
  "version": "0.1.0",
  "private": true,
  "description": "Local HTML document viewer for AI-generated specifications.",
  "keywords": [
    "documentation",
    "html",
    "viewer",
    "mermaid",
    "chart.js"
  ],
  "license": "MIT",
  "author": "Spec HTML contributors",
  "type": "module",
  "bin": {
    "spec-html": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "RELEASING.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/authoring.html",
    "docs/implementation-plan.html",
    "docs/mermaid-showcase.html",
    "docs/charts-showcase.html"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:pack": "node ./scripts/test-pack.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:browser && npm run test:pack",
    "prepack": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "node ./scripts/refuse-publish.mjs"
  },
  "dependencies": {
    "open": "^11.0.1"
  },
  "peerDependencies": {
    "chart.js": "^4.5.1",
    "mermaid": "^11.16.1"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "mermaid": "^11.16.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
